                    "expr": "golobby_websocket_connections_active",
                    "legendFormat": "WS Connections"
                }
            ]
        },
        {
            "datasource": "Prometheus",
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "custom": {
                        "lineWidth": 2
                    }
                }
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 5
            },
            "id": 5,
            "title": "Match Search Latency (p50 / p95 / p99)",
            "type": "timeseries",
            "targets": [
                {
                    "expr": "histogram_quantile(0.50, rate(golobby_matchmaking_search_latency_seconds_bucket[5m]))",
                    "legendFormat": "p50"
                },
                {
                    "expr": "histogram_quantile(0.95, rate(golobby_matchmaking_search_latency_seconds_bucket[5m]))",
                    "legendFormat": "p95"
                },
                {
                    "expr": "histogram_quantile(0.99, rate(golobby_matchmaking_search_latency_seconds_bucket[5m]))",
                    "legendFormat": "p99"
                }
            ]
        },
        {
            "datasource": "Prometheus",
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                }
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 5
            },
            "id": 6,
            "title": "Match Rate (per minute)",
            "type": "timeseries",
            "targets": [
                {
                    "expr": "rate(golobby_matchmaking_match_found_total[1m]) * 60",
                    "legendFormat": "{{category}}"
                }
            ]
        },
        {
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
