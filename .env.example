# ═══════════════════════════════════════════════════════
# GoLobby Matchmaking Engine — Environment Variables
# Copy this to .env and fill in production values.
# ═══════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────
APP_ENV=development
APP_PORT=8080
METRICS_PORT=2112
LOG_LEVEL=DEBUG

# ── Database ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT_EXTERNAL=5433      # host-mapped port (connect from your machine)
DB_PORT=5432               # internal postgres port
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=golobby

# ── Redis ─────────────────────────────────────────────────
# When running locally (outside Docker): use localhost + DB_PORT_EXTERNAL
# When running inside Docker: the Go app uses REDIS_HOST=redis (service name)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_DB=0

# ── Security ──────────────────────────────────────────────
# CHANGE THESE IN PRODUCTION — minimum 32 random characters
JWT_SECRET=your-super-secret-jwt-key-change-me-in-production
OCR_WEBHOOK_SECRET=ocr-webhook-secret-changeme

# ── Matchmaking Tuning ────────────────────────────────────
MATCHMAKING_TIMEOUT=30       # seconds before extending rank range
READY_TIMEOUT=60             # seconds to confirm ready before ghosting penalty
INITIAL_RANK_RANGE=2         # ±2 rank tolerance initial search
EXTENDED_RANK_RANGE=4        # ±4 rank tolerance after timeout
GHOSTING_PENALTY=-10         # reputation points deducted for ghosting

# ── Rate Limiting ─────────────────────────────────────────
ENABLE_RATE_LIMIT=false      # set to true in production

# ── OCR Microservice ──────────────────────────────────────
OCR_PORT=8001
OCR_SERVICE_URL=http://localhost:8001
OCR_MIN_CONFIDENCE=60.0      # below this % → result flagged as disputed

# ── Frontend ──────────────────────────────────────────────
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws

# ── Monitoring ────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=golobby2024
